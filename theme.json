				"typography": {
					"fontSize": "var(--wp--preset--font-size--prose)",
					"lineHeight": "var(--wp--custom--line-height--prose)"
				},
				"css": "&.kahel-page-content { margin-top: var(--wp--custom--page--content-margin-top); margin-bottom: var(--wp--custom--page--content-margin-bottom); } & > * + * { margin-block-start: 1.25em; } & ul { padding-inline-start: 1.35em; } & ol { padding-inline-start: 1.35em; } & li + li { margin-block-start: 0.4em; } & code { padding: 0.12em 0.4em; border-radius: var(--wp--custom--radius--md); background: var(--wp--preset--color--cream); font-size: 0.92em; } & kbd { padding: 0.12em 0.4em; border-radius: var(--wp--custom--radius--md); background: var(--wp--preset--color--cream); font-size: 0.92em; } & samp { padding: 0.12em 0.4em; border-radius: var(--wp--custom--radius--md); background: var(--wp--preset--color--cream); font-size: 0.92em; } & pre { padding: 1.1rem 1.25rem; overflow-x: auto; border-radius: var(--wp--custom--radius--md); background: var(--wp--preset--color--cream); } & pre code { padding: 0; background: transparent; } & blockquote { margin: 2.4em 0; padding: 10px 0 10px 28px; border-left: 4px solid var(--wp--preset--color--orange); font-size: var(--wp--preset--font-size--quote); font-weight: 800; line-height: var(--wp--custom--line-height--quote); letter-spacing: -0.045em; } & blockquote p { margin: 0; } & hr { border: 0; height: 1px; background: var(--wp--preset--color--line); } & table { width: 100%; border-collapse: collapse; font-size: var(--wp--custom--table--font-size); } & th { padding: var(--wp--custom--table--cell-padding); border: 1px solid var(--wp--preset--color--line); text-align: left; vertical-align: top; background: var(--wp--preset--color--cream); font-weight: 800; } & td { padding: var(--wp--custom--table--cell-padding); border: 1px solid var(--wp--preset--color--line); text-align: left; vertical-align: top; } & thead td { background: var(--wp--preset--color--cream); font-weight: 800; } & dl { margin: 1.5em 0; } & dt { font-weight: 800; margin-top: 0.85em; } & dd { margin: 0.35em 0 0; color: var(--wp--preset--color--muted); } & address { font-style: normal; } & mark { background: var(--wp--preset--color--apricot); color: var(--wp--preset--color--ink); padding: 0.05em 0.2em; }"
			},
			"core/group": {
				"css": "&.kahel-page-header { padding-top: var(--wp--custom--page--header-padding-top); padding-bottom: var(--wp--custom--page--header-padding-bottom); } &.kahel-values { padding-top: var(--wp--custom--page--values-padding-y); padding-bottom: var(--wp--custom--page--values-padding-y); } &.kahel-value-card { min-height: var(--wp--custom--page--value-card-min-height); } &.kahel-value-card > p:first-child { margin: 0; font-weight: var(--wp--custom--weight--strong); letter-spacing: 0.12em; } &.kahel-contributors { margin-top: var(--wp--custom--page--contributors-margin-y); margin-bottom: var(--wp--custom--page--contributors-margin-y); } &.kahel-contributor-list { border-top: 1px solid var(--wp--preset--color--line); } &.kahel-contributor { padding-top: var(--wp--custom--page--contributor-padding-y); padding-bottom: var(--wp--custom--page--contributor-padding-y); border-bottom: 1px solid var(--wp--preset--color--line); }"
			},
			"core/heading": {
				"css": "&.kahel-values-title { max-width: var(--wp--custom--page--section-title-max); margin: 0; } &.kahel-contributors-title { max-width: var(--wp--custom--page--contributors-title-max); margin: 0; } &.kahel-value-card-title { margin: 0 0 8px; } &.kahel-contributor-name { margin: 0 0 5px; }"
			},
			"core/columns": {
				"css": "&.kahel-values-head { gap: var(--wp--custom--page--values-head-gap); align-items: end; margin-bottom: var(--wp--custom--page--values-head-margin-bottom); } &.kahel-contributors-columns { gap: var(--wp--custom--page--contributors-gap); align-items: start; }"
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "1.35em"
					}
				}
			},
			"core/table": {
				"typography": {
