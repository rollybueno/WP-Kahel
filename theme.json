			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2X-Small",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "X-Small",
					"size": "12px"
				},
				{
