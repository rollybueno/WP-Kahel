		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": {
				"default": "28px",
				"mobile": "22px",
				"md": "12px",
				"lg": "20px",
				"xl": "26px",
				"pill": "999px"
			},
			"weight": {
				"heading": "850",
				"strong": "900",
				"feature": "750",
				"button": "800"
			},
			"letter-spacing": {
				"heading": "-0.05em",
				"h1": "-0.065em",
				"h2": "-0.04em",
				"h3": "-0.045em",
				"content": "-0.06em",
				"feature": "-0.025em",
				"kicker": "0.13em",
				"brand": "-0.04em"
			},
			"line-height": {
				"body": "1.65",
				"lead": "1.6",
				"prose": "1.82",
				"small": "1.55",
				"caption": "1.5",
				"heading": "1.08",
				"h1": "0.9",
				"section": "0.94",
				"content": "0.98",
				"quote": "1.15"
			},
			"layout": {
				"gutter": "20px",
				"gutter-mobile": "14px",
				"min-width": "320px"
			},
			"button": {
				"min-height": "48px",
				"min-height-sm": "44px"
			},
			"footer": {
				"brand-max": "680px",
				"title-max": "10ch",
				"copy-max": "54ch",
				"padding-top": "clamp(72px, 9vw, 120px)",
				"padding-bottom": "28px",
				"top-gap": "clamp(36px, 7vw, 96px)",
				"top-padding-bottom": "clamp(52px, 7vw, 86px)",
				"cta-min-height": "50px"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"right": "var(--wp--custom--layout--gutter)",
				"bottom": "0px",
				"left": "var(--wp--custom--layout--gutter)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "var(--wp--custom--weight--heading)",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "var(--wp--custom--line-height--h1)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h1)",
					"fontWeight": "var(--wp--custom--weight--heading)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h2)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h2)",
					"fontWeight": "var(--wp--custom--weight--heading)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h3)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h3)",
					"fontWeight": "var(--wp--custom--weight--heading)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--feature)",
					"fontWeight": "var(--wp--custom--weight--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--feature)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--utility)",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--orange-deep)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--orange)",
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"lineHeight": "1"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.125rem",
						"bottom": "0.75rem",
						"left": "1.125rem"
					}
				},
				"shadow": "var(--wp--preset--shadow--button)",
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--orange-deep)",
						"text": "var(--wp--preset--color--cream)"
					}
				},
				":focus": {
					"shadow": "var(--wp--preset--shadow--focus)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"lineHeight": "var(--wp--custom--line-height--caption)"
				}
			},
			"cite": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "var(--wp--custom--line-height--body)"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--orange)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"right": "0",
						"bottom": "10px",
						"left": "28px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "800",
					"lineHeight": "var(--wp--custom--line-height--quote)",
					"letterSpacing": "-0.045em"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var(--wp--preset--color--orange)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "800",
					"lineHeight": "var(--wp--custom--line-height--quote)",
					"letterSpacing": "-0.045em"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--line)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--default)"
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "var(--wp--custom--radius--default)"
				},
				"shadow": "var(--wp--preset--shadow--media)"
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.1rem",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"letterSpacing": "var(--wp--custom--letter-spacing--brand)",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "400"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"color": "var(--wp--preset--color--line)",
					"width": "1px",
					"style": "solid"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "var(--wp--custom--weight--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h1)",
					"lineHeight": "var(--wp--custom--line-height--h1)"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"fontWeight": "800"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "0.84rem",
					"fontWeight": "850"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--cream)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--cream)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			}
		}
	}
}
