					"radius": "var(--wp--custom--radius--md)",
					"width": "1px",
					"style": "solid"
				},
				"css": "& table { border-collapse: collapse; width: 100%; } & th, & td { padding: var(--wp--custom--table--cell-padding); border-color: var(--wp--preset--color--line); text-align: left; vertical-align: top; } & thead th, & thead td, & th { background: var(--wp--preset--color--cream); font-weight: 800; } & figcaption { margin-top: 0.75rem; color: var(--wp--preset--color--muted); font-size: var(--wp--preset--font-size--caption); }"
			},
