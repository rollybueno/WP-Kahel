	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"right": "var(--wp--custom--layout--gutter)",
				"bottom": "0px",
				"left": "var(--wp--custom--layout--gutter)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "var(--wp--custom--weight--heading)",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "var(--wp--custom--line-height--h-1)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h-1)",
					"fontWeight": "var(--wp--custom--weight--heading)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-2)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h-2)",
					"fontWeight": "var(--wp--custom--weight--heading)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-3)",
					"lineHeight": "var(--wp--custom--line-height--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--h-3)",
					"fontWeight": "var(--wp--custom--weight--heading)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--feature)",
					"fontWeight": "var(--wp--custom--weight--heading)",
					"letterSpacing": "var(--wp--custom--letter-spacing--feature)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--utility)",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"letterSpacing": "var(--wp--custom--letter-spacing--kicker)",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--orange-deep)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--orange)",
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "var(--wp--custom--weight--strong)",
					"lineHeight": "1"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.125rem",
						"bottom": "0.75rem",
						"left": "1.125rem"
					}
				},
				"shadow": "var(--wp--preset--shadow--button)",
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--orange-deep)",
						"text": "var(--wp--preset--color--cream)"
					}
				},
				":focus": {
					"shadow": "var(--wp--preset--shadow--focus)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"lineHeight": "var(--wp--custom--line-height--caption)"
				}
			},
			"cite": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"lineHeight": "var(--wp--custom--line-height--body)"
				},
				"css": "&.kahel-kicker { display: flex; align-items: center; gap: 10px; margin: 0 0 20px; font-weight: var(--wp--custom--weight--strong); letter-spacing: var(--wp--custom--letter-spacing--kicker); text-transform: uppercase; } &.kahel-kicker::before { content: \"\"; width: var(--wp--custom--page--kicker-rule); height: 3px; border-radius: var(--wp--custom--radius--pill); background: var(--wp--preset--color--orange); } &.kahel-contributor-role { margin: 0; font-weight: var(--wp--custom--weight--strong); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }"
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--orange)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"spacing": {
					"padding": {
						"top": "10px",
						"right": "0",
						"bottom": "10px",
						"left": "28px"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "800",
					"lineHeight": "var(--wp--custom--line-height--quote)",
					"letterSpacing": "-0.045em"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var(--wp--preset--color--orange)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--quote)",
					"fontWeight": "800",
					"lineHeight": "var(--wp--custom--line-height--quote)",
					"letterSpacing": "-0.045em"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--line)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--default)"
				}
			},
