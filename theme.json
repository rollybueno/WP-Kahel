					}
				},
				{
					"slug": "h3",
					"name": "H3",
					"size": "1.6rem",
					"fluid": {
						"min": "1.35rem",
						"max": "2rem"
					}
				},
				{
					"slug": "h2",
					"name": "H2",
					"size": "1.4rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.6rem"
