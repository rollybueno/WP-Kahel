				},
				{
					"slug": "quote",
					"name": "Quote",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.45rem"
					}
				},
				{
					"slug": "content",
					"name": "Content",
					"size": "2.8rem",
					"fluid": {
						"min": "2.1rem",
						"max": "3.8rem"
					}
				},
				{
					"slug": "section",
					"name": "Section",
					"size": "4rem",
					"fluid": {
						"min": "2.8rem",
						"max": "5.6rem"
					}
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "5.5rem",
					"fluid": {
						"min": "3.5rem",
						"max": "8.3rem"
					}
				},
				{
					"slug": "stat",
					"name": "Stat",
					"size": "5rem",
