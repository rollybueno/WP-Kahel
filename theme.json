		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "button",
					"name": "Button",
					"shadow": "0 8px 22px rgba(201, 82, 18, 0.18)"
				},
				{
					"slug": "button-lg",
					"name": "Button Large",
					"shadow": "0 12px 30px rgba(244, 122, 31, 0.2)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 18px 44px rgba(88, 46, 18, 0.08)"
				},
				{
					"slug": "card-hover",
					"name": "Card Hover",
					"shadow": "0 24px 54px rgba(88, 46, 18, 0.13)"
				},
				{
					"slug": "media",
					"name": "Media",
					"shadow": "0 24px 60px rgba(104, 49, 14, 0.12)"
				},
				{
					"slug": "search",
					"name": "Search",
					"shadow": "0 14px 35px rgba(88, 46, 18, 0.07)"
				},
				{
					"slug": "focus",
					"name": "Focus",
					"shadow": "0 0 0 3px rgba(244, 122, 31, 0.12)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"letterSpacing": true,
			"fontStyle": true,
			"fontWeight": true,
			"textTransform": true,
			"dropCap": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-latin-ext.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-latin.woff2"
							]
						}
					]
				},
				{
					"slug": "source-serif",
					"name": "Source Serif 4",
					"fontFamily": "\"Source Serif 4\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-latin-ext.woff2"
							]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-latin.woff2"
							]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "400 800",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-italic-latin-ext.woff2"
							]
						},
						{
							"fontFamily": "Source Serif 4",
							"fontWeight": "400 800",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-italic-latin.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "utility",
					"name": "Utility",
					"size": "0.76rem"
				},
				{
					"slug": "caption",
					"name": "Caption",
					"size": "0.78rem"
				},
				{
					"slug": "kicker",
					"name": "Kicker",
					"size": "0.8rem"
				},
				{
